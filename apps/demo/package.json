{
  "name": "@nx-devkit/demo-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Minimal Nx workspace that exercises all 4 @nx-devkit/* inference plugins (tsdown, oxlint, biome, typescript-preset).",
  "type": "module",
  "scripts": {
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint",
    "format": "nx run-many -t format",
    "test": "nx run-many -t test"
  },
  "devDependencies": {
    "@nx-devkit/biome": "workspace:*",
    "@nx-devkit/oxlint": "workspace:*",
    "@nx-devkit/tsdown": "workspace:*",
    "@nx-devkit/typescript": "workspace:*",
    "@nx/devkit": "24.0.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "nx": "24.0.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  }
}
