{
  "name": "nx-devkit-plugins",
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "packageManager": "bun@1.3.14",
  "cli": {
    "packageManager": "bun"
  },
  "version": 2,
  "plugins": [
    "./packages/typescript-preset/src/plugin.ts",
    "./packages/prepare-for-release/src/plugin.ts",
    "./packages/nx-cloud/src/plugin.ts"
  ],
  "release": {
    "projects": [
      "packages/tsdown",
      "packages/oxlint",
      "packages/biome",
      "packages/typescript-preset",
      "packages/prepare-for-release",
      "packages/skill",
      "packages/skillspector",
      "packages/release",
      "packages/nx-cloud"
    ],
    "projectsRelationship": "independent",
    "version": {
      "conventionalCommits": {
        "useCommitScope": false
      },
      "fallbackCurrentVersionResolver": "disk",
      "generatorOptions": {
        "packageRoot": "packages/{projectName}"
      },
      "git": {
        "commit": true,
        "commitMessage": "chore(release): publish {version}",
        "tag": true,
        "push": true
      }
    },
    "changelog": {
      "projectChangelogs": {
        "createRelease": "github"
      }
    }
  },
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/biome.json",
      "{workspaceRoot}/.oxlintrc.json"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "test": {
      "cache": true
    }
  }
}
