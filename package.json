{
  "name": "nx-devkit-plugins",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Zero-config Nx plugin inference for tsdown, oxlint, biome, typescript/vitest",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "build": "bun run --filter='./packages/*' build",
    "test": "bun run --filter='./packages/*' test",
    "lint": "node scripts/biome.mjs lint . && oxlint .",
    "lint:oxlint": "oxlint .",
    "format": "node scripts/biome.mjs format --write .",
    "format:check": "node scripts/biome.mjs format .",
    "spec:check": "bun run scripts/spec-check.ts",
    "check:spec": "bun run scripts/spec-check.ts",
    "spec:validate": "nx run nx-devkit-plugins:spec-validate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@fission-ai/openspec": "^1.4.1",
    "@nx-devkit/skills-compiler": "workspace:*",
    "@nx/devkit": "23.2.1",
    "@types/node": "^20.19.0",
    "@typescript/native-preview": "^7.0.0-dev.20260622.1",
    "husky": "^9.1.7",
    "knip": "^6.0.0",
    "markdownlint-cli2": "^0.23.2",
    "nx": "23.2.1",
    "oxlint": "^1.70.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "nanoid": "3.3.19",
    "postcss": "8.5.28",
    "smol-toml": "1.8.0"
  },
  "engines": {
    "node": ">=22.18.0",
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14"
}
