{
  "name": "@nx-devkit/biome",
  "version": "0.1.18",
  "license": "MIT",
  "description": "Standalone Nx plugin: infers format, format-check, and lint targets from biome.json \u2014 no project.json required.",
  "keywords": [
    "nx",
    "nx-plugin",
    "biome",
    "formatter",
    "linter",
    "format",
    "typescript",
    "monorepo",
    "zero-config"
  ],
  "private": false,
  "type": "module",
  "main": "./dist/plugin.mjs",
  "module": "./dist/plugin.mjs",
  "types": "./dist/plugin.d.mts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.mts",
      "default": "./dist/plugin.mjs"
    },
    "./package.json": "./package.json",
    "./generators/init": {
      "types": "./dist/generators/init/generator.d.mts",
      "default": "./dist/generators/init/generator.mjs"
    }
  },
  "files": [
    "dist",
    "generators.json",
    "src/generators/init/schema.json"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@biomejs/biome": "^2.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@nx-devkit/internal": "0.0.0",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nx-devkit/nx.ts",
    "directory": "packages/biome"
  },
  "bugs": {
    "url": "https://github.com/nx-devkit/nx.ts/issues"
  },
  "homepage": "https://github.com/nx-devkit/nx.ts/tree/main/packages/biome",
  "dependencies": {
    "@nx/devkit": "^22.0.0 || ^23.0.0",
    "jsonc-parser": "^3.3.1"
  },
  "generators": "./generators.json"
}
