{
  "name": "@nx-devkit/biome",
  "version": "0.1.6",
  "license": "MIT",
  "description": "Standalone Nx plugin: infers format, format-check, and lint targets from biome.json — no project.json required.",
  "keywords": [
    "nx",
    "nx-plugin",
    "biome",
    "formatter",
    "linter",
    "format",
    "typescript",
    "monorepo",
    "zero-config"
  ],
  "private": false,
  "type": "module",
  "main": "./dist/plugin.mjs",
  "module": "./dist/plugin.mjs",
  "types": "./dist/plugin.d.mts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.mts",
      "default": "./dist/plugin.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@biomejs/biome": "^2.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@nx-devkit/internal": "workspace:*",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nx-devkit/nx.ts",
    "directory": "packages/biome"
  },
  "bugs": {
    "url": "https://github.com/nx-devkit/nx.ts/issues"
  },
  "homepage": "https://github.com/nx-devkit/nx.ts/tree/main/packages/biome",
  "dependencies": {
    "@nx/devkit": "^22.0.0 || ^23.0.0"
  }
}
