{
  "name": "@nx-devkit/boundaries",
  "version": "0.0.16",
  "private": false,
  "description": "Linter-agnostic Nx plugin: enforces module-boundary depConstraints between tagged projects — no ESLint, no project.json required.",
  "keywords": [
    "architecture",
    "enforce-module-boundaries",
    "module-boundaries",
    "monorepo",
    "nx",
    "nx-plugin",
    "typescript",
    "zero-config"
  ],
  "homepage": "https://github.com/nx-devkit/nx.ts/tree/main/packages/boundaries",
  "bugs": {
    "url": "https://github.com/nx-devkit/nx.ts/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nx-devkit/nx.ts",
    "directory": "packages/boundaries"
  },
  "files": [
    "dist",
    "executors.json",
    "README.md",
    "src/executors/check-boundaries/schema.json",
    "generators.json",
    "src/generators/init/schema.json"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "default": "./dist/plugin.mjs"
    },
    "./package.json": "./package.json",
    "./generators/init": {
      "types": "./dist/generators/init/generator.d.mts",
      "default": "./dist/generators/init/generator.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "npm run build -- --clean",
    "test": "vitest run"
  },
  "dependencies": {
    "@nx/devkit": "^24.0.0",
    "jsonc-parser": "^3.3.1",
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "@nx-devkit/internal": "0.0.0",
    "@types/node": "^26.6.6",
    "memfs": "^4.50.0",
    "tsdown": "^0.23.7",
    "vitest": "^5.1.0"
  },
  "executors": "./executors.json",
  "generators": "./generators.json"
}
