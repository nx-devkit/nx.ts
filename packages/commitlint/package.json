{
  "name": "@nx-devkit/commitlint",
  "version": "0.0.1",
  "license": "MIT",
  "description": "Nx plugin: commitlint config files infer a commitlint target — conventional-commit linting without project.json.",
  "keywords": [
    "nx",
    "nx-plugin",
    "commitlint",
    "conventional-commits",
    "git",
    "zero-config"
  ],
  "private": false,
  "type": "module",
  "main": "./dist/plugin.mjs",
  "module": "./dist/plugin.mjs",
  "types": "./dist/plugin.d.mts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.mts",
      "default": "./dist/plugin.mjs"
    },
    "./package.json": "./package.json",
    "./generators/init": {
      "types": "./dist/generators/init/generator.d.mts",
      "default": "./dist/generators/init/generator.mjs"
    }
  },
  "files": [
    "dist",
    "generators.json",
    "src/generators/init/schema.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@commitlint/cli": "^20.0.0"
  },
  "devDependencies": {
    "@nx-devkit/internal": "0.0.0",
    "@types/node": "^26.0.0",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nx-devkit/nx.ts",
    "directory": "packages/commitlint"
  },
  "bugs": {
    "url": "https://github.com/nx-devkit/nx.ts/issues"
  },
  "homepage": "https://github.com/nx-devkit/nx.ts/tree/main/packages/commitlint",
  "dependencies": {
    "@nx/devkit": "^22.0.0 || ^23.0.0"
  },
  "generators": "./generators.json"
}
