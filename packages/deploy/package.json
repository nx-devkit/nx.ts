{
  "name": "@nx-devkit/deploy",
  "version": "0.0.0",
  "private": false,
  "description": "Nx plugin: wrangler.toml, fly.toml, vercel.json and netlify.toml infer uncached deploy (and continuous dev) targets — no project.json required.",
  "keywords": [
    "cloudflare",
    "deploy",
    "fly",
    "netlify",
    "nx",
    "nx-plugin",
    "vercel",
    "wrangler",
    "zero-config"
  ],
  "homepage": "https://github.com/nx-devkit/nx.ts/tree/main/packages/deploy",
  "bugs": {
    "url": "https://github.com/nx-devkit/nx.ts/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nx-devkit/nx.ts",
    "directory": "packages/deploy"
  },
  "files": [
    "dist",
    "generators.json",
    "src/generators/init/schema.json",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/plugin.mjs",
  "module": "./dist/plugin.mjs",
  "types": "./dist/plugin.d.mts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.mts",
      "default": "./dist/plugin.mjs"
    },
    "./package.json": "./package.json",
    "./generators/init": {
      "types": "./dist/generators/init/generator.d.mts",
      "default": "./dist/generators/init/generator.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run"
  },
  "dependencies": {
    "@nx/devkit": "^24.0.0"
  },
  "devDependencies": {
    "@nx-devkit/internal": "0.0.0",
    "@types/node": "^26.6.6",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "generators": "./generators.json"
}
