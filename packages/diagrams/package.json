{
  "name": "@nx-devkit/diagrams",
  "version": "0.0.4",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "default": "./dist/plugin.mjs"
    },
    "./generators/init": {
      "types": "./dist/generators/init/generator.d.mts",
      "default": "./dist/generators/init/generator.mjs"
    },
    "./package.json": "./package.json"
  },
  "executors": "./executors.json",
  "generators": "./generators.json",
  "files": [
    "dist",
    "executors.json",
    "generators.json",
    "src/executors/render/schema.json",
    "src/generators/init/schema.json",
    "README.md",
    "docs/pipeline.svg"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "npm run build -- --clean",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@nx/devkit": "^22.0.0 || ^23.0.0"
  },
  "devDependencies": {
    "@nx-devkit/internal": "workspace:*",
    "@nx/devkit": "23.2.1",
    "@types/node": "^20.19.0",
    "memfs": "^4.50.0",
    "minimatch": "^10.2.4",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nx-devkit/nx.ts",
    "directory": "packages/diagrams"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
