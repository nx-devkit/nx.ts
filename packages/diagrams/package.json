{
  "name": "@nx-devkit/diagrams",
  "version": "0.0.22",
  "private": false,
  "description": "Nx plugin that renders text-diagram sources (PlantUML, Mermaid, D2, Graphviz, BPMN, Excalidraw) into cached, atomized targets via Kroki or local renderers.",
  "keywords": [
    "bpmn",
    "d2",
    "diagram-as-code",
    "diagrams",
    "excalidraw",
    "graphviz",
    "kroki",
    "mermaid",
    "nx",
    "nx-plugin",
    "plantuml"
  ],
  "homepage": "https://github.com/nx-devkit/nx.ts/tree/main/packages/diagrams",
  "bugs": {
    "url": "https://github.com/nx-devkit/nx.ts/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nx-devkit/nx.ts",
    "directory": "packages/diagrams"
  },
  "files": [
    "dist",
    "executors.json",
    "generators.json",
    "src/executors/render/schema.json",
    "src/generators/init/schema.json",
    "README.md",
    "docs/pipeline.svg",
    "README-1.svg"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "default": "./dist/plugin.mjs"
    },
    "./generators/init": {
      "types": "./dist/generators/init/generator.d.mts",
      "default": "./dist/generators/init/generator.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "npm run build -- --clean",
    "test": "vitest run"
  },
  "dependencies": {
    "@nx/devkit": "^24.0.0",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@nx-devkit/internal": "0.0.0",
    "@types/node": "^26.6.6",
    "memfs": "^4.50.0",
    "minimatch": "^11.0.5",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "executors": "./executors.json",
  "generators": "./generators.json"
}
