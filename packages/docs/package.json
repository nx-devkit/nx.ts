{
  "name": "@nx-devkit/docs",
  "version": "0.0.0",
  "private": false,
  "description": "Standalone Nx plugin: .vitepress/config.* and astro.config.* (incl. Starlight) infer docs:dev, docs:build and docs:preview targets — no project.json required.",
  "keywords": [
    "astro",
    "docs",
    "documentation",
    "monorepo",
    "nx",
    "nx-plugin",
    "starlight",
    "vitepress",
    "zero-config"
  ],
  "homepage": "https://github.com/nx-devkit/nx.ts/tree/main/packages/docs",
  "bugs": {
    "url": "https://github.com/nx-devkit/nx.ts/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nx-devkit/nx.ts",
    "directory": "packages/docs"
  },
  "files": [
    "dist",
    "generators.json",
    "src/generators/init/schema.json",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/plugin.mjs",
  "module": "./dist/plugin.mjs",
  "types": "./dist/plugin.d.mts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.mts",
      "default": "./dist/plugin.mjs"
    },
    "./package.json": "./package.json",
    "./generators/init": {
      "types": "./dist/generators/init/generator.d.mts",
      "default": "./dist/generators/init/generator.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run"
  },
  "dependencies": {
    "@nx/devkit": "^24.0.0",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@nx-devkit/internal": "0.0.0",
    "@types/node": "^26.6.6",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "astro": "^4.0.0 || ^5.0.0",
    "vitepress": "^1.0.0 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "vitepress": {
      "optional": true
    }
  },
  "generators": "./generators.json"
}
