{
  "name": "@nx-devkit/markdownlint",
  "version": "0.0.8",
  "private": false,
  "description": "Nx plugin: .markdownlint config files infer a cached lint-md target — Markdown linting without project.json.",
  "keywords": [
    "docs",
    "lint",
    "linter",
    "markdown",
    "markdownlint",
    "monorepo",
    "nx",
    "nx-plugin",
    "zero-config"
  ],
  "homepage": "https://github.com/nx-devkit/nx.ts/tree/main/packages/markdownlint",
  "bugs": {
    "url": "https://github.com/nx-devkit/nx.ts/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nx-devkit/nx.ts",
    "directory": "packages/markdownlint"
  },
  "files": [
    "dist",
    "generators.json",
    "src/generators/init/schema.json",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/plugin.mjs",
  "module": "./dist/plugin.mjs",
  "types": "./dist/plugin.d.mts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.mts",
      "default": "./dist/plugin.mjs"
    },
    "./package.json": "./package.json",
    "./generators/init": {
      "types": "./dist/generators/init/generator.d.mts",
      "default": "./dist/generators/init/generator.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run"
  },
  "dependencies": {
    "@nx/devkit": "^24.0.0",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@nx-devkit/internal": "0.0.0",
    "@types/node": "^26.6.6",
    "markdownlint-cli2": "^0.24.0",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "markdownlint-cli2": "^0.24.0"
  },
  "generators": "./generators.json"
}
