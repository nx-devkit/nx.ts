{
  "name": "@nx-devkit/nx-cloud",
  "version": "0.0.21",
  "private": false,
  "description": "Nx plugin that adds an nx-cloud-rotate target to the workspace root — rolls over to a fresh Nx Cloud organization when quota is exhausted.",
  "keywords": [
    "cache",
    "nx",
    "nx-cloud",
    "nx-cloud-rotate",
    "nx-plugin",
    "remote-cache"
  ],
  "homepage": "https://github.com/nx-devkit/nx.ts/tree/main/packages/nx-cloud",
  "bugs": {
    "url": "https://github.com/nx-devkit/nx.ts/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nx-devkit/nx.ts",
    "directory": "packages/nx-cloud"
  },
  "files": [
    "dist",
    "executors.json",
    "generators.json",
    "src/executors/rotate/schema.json",
    "src/generators/init/schema.json",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "default": "./dist/plugin.mjs"
    },
    "./generators/init": {
      "types": "./dist/generators/init/generator.d.mts",
      "default": "./dist/generators/init/generator.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "npm run build -- --clean",
    "test": "vitest run"
  },
  "dependencies": {
    "@nx/devkit": "^24.0.0",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@nx-devkit/internal": "0.0.0",
    "@types/node": "^26.6.6",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "executors": "./executors.json",
  "generators": "./generators.json"
}
