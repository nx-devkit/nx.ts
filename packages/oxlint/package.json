{
  "name": "@nx-devkit/oxlint",
  "version": "0.1.8",
  "license": "MIT",
  "description": "Standalone Nx plugin: infers a cached lint target from .oxlintrc config files — no project.json required.",
  "keywords": [
    "nx",
    "nx-plugin",
    "oxlint",
    "oxc",
    "lint",
    "linter",
    "typescript",
    "monorepo",
    "zero-config"
  ],
  "private": false,
  "type": "module",
  "main": "./dist/plugin.mjs",
  "module": "./dist/plugin.mjs",
  "types": "./dist/plugin.d.mts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.mts",
      "default": "./dist/plugin.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run"
  },
  "peerDependencies": {
    "oxlint": "^1.0.0"
  },
  "devDependencies": {
    "@nx-devkit/internal": "workspace:*",
    "@types/node": "^26.0.0",
    "memfs": "^4.57.8",
    "oxlint": "^1.0.0",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nx-devkit/nx.ts",
    "directory": "packages/oxlint"
  },
  "bugs": {
    "url": "https://github.com/nx-devkit/nx.ts/issues"
  },
  "homepage": "https://github.com/nx-devkit/nx.ts/tree/main/packages/oxlint",
  "dependencies": {
    "@nx/devkit": "^22.0.0 || ^23.0.0"
  }
}
