{
  "name": "@nx-devkit/prepare-for-release",
  "version": "0.1.26",
  "private": false,
  "description": "Nx plugin that bootstraps npm publishing: 0.0.0 placeholder releases for unpublished packages plus OIDC trusted-publishing setup.",
  "keywords": [
    "monorepo",
    "npm",
    "npm-publish",
    "nx",
    "nx-plugin",
    "oidc",
    "release",
    "trusted-publishing"
  ],
  "homepage": "https://github.com/nx-devkit/nx.ts/tree/main/packages/prepare-for-release",
  "bugs": {
    "url": "https://github.com/nx-devkit/nx.ts/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nx-devkit/nx.ts",
    "directory": "packages/prepare-for-release"
  },
  "files": [
    "dist",
    "executors.json",
    "generators.json",
    "src/executors/publish-placeholder/schema.json",
    "src/generators/init/schema.json",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "default": "./dist/plugin.mjs"
    },
    "./generators/init": {
      "types": "./dist/generators/init/generator.d.mts",
      "default": "./dist/generators/init/generator.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "npm run build -- --clean",
    "test": "vitest run"
  },
  "dependencies": {
    "@nx/devkit": "^24.0.0",
    "tinyglobby": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "executors": "./executors.json",
  "generators": "./generators.json"
}
