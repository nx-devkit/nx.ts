{
  "name": "@nx-devkit/release",
  "version": "0.0.10",
  "license": "MIT",
  "description": "Zero-config Nx plugin for automated npm releases via CI — version bump, OIDC publish, git tag, and GitHub Release, fully idempotent.",
  "keywords": [
    "nx",
    "nx-plugin",
    "release",
    "npm-publish",
    "oidc",
    "provenance",
    "ci",
    "automation"
  ],
  "private": false,
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "default": "./dist/plugin.mjs"
    },
    "./package.json": "./package.json"
  },
  "executors": "./executors.json",
  "generators": "./generators.json",
  "files": [
    "dist",
    "executors.json",
    "generators.json",
    "src/executors/publish/schema.json",
    "src/generators/init/schema.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "npm run build -- --clean",
    "test": "vitest run"
  },
  "dependencies": {
    "@nx/devkit": "^22.0.0 || ^23.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "memfs": "^4.50.0",
    "tsdown": "^0.22.3",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nx-devkit/nx.ts",
    "directory": "packages/release"
  },
  "bugs": {
    "url": "https://github.com/nx-devkit/nx.ts/issues"
  },
  "homepage": "https://github.com/nx-devkit/nx.ts/tree/main/packages/release"
}
