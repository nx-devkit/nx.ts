  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "tsdown --clean",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@nx/devkit": "^22.0.0 || ^23.0.0"
  },
  "dependencies": {
    "@nx/devkit": "22.7.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "memfs": "^4.50.0",
    "tsdown": "^0.22.3",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nx-devkit/nx.ts",
    "directory": "packages/release"
  }
