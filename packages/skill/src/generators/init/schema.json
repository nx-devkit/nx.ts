{
  "$schema": "https://json-schema.org/schema",
  "type": "object",
  "title": "Init generator",
  "description": "Registers @nx-devkit/skill in nx.json plugins.",
  "properties": {
    "pluginPath": {
      "type": "string",
      "default": "@nx-devkit/skill",
      "minLength": 1,
      "description": "Plugin specifier to register (e.g. a local path during development)."
    }
  },
  "additionalProperties": false
}
