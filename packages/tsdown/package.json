{
  "name": "@nx-devkit/tsdown",
  "version": "0.1.19",
  "license": "MIT",
  "description": "Standalone Nx plugin: infers a cached build target from tsdown.config.ts \u2014 no project.json required.",
  "keywords": [
    "nx",
    "nx-plugin",
    "tsdown",
    "rolldown",
    "build",
    "bundler",
    "typescript",
    "monorepo",
    "zero-config"
  ],
  "private": false,
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "default": "./dist/plugin.mjs"
    },
    "./package.json": "./package.json",
    "./generators/init": {
      "types": "./dist/generators/init/generator.d.mts",
      "default": "./dist/generators/init/generator.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "generators.json",
    "src/generators/init/schema.json"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run"
  },
  "dependencies": {
    "@nx/devkit": "^24.0.0",
    "jsonc-parser": "^3.3.1",
    "tsdown": "^0.23.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "memfs": "^4.50.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "@nx-devkit/internal": "0.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nx-devkit/nx.ts",
    "directory": "packages/tsdown"
  },
  "bugs": {
    "url": "https://github.com/nx-devkit/nx.ts/issues"
  },
  "homepage": "https://github.com/nx-devkit/nx.ts/tree/main/packages/tsdown",
  "generators": "./generators.json"
}
