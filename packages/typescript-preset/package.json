{
  "name": "@nx-devkit/typescript",
  "version": "0.2.23",
  "private": false,
  "description": "Preset Nx plugin that infers typecheck, test, lint, format, and build targets from config files you already keep — no project.json required. One-command bootstrap: npx @nx-devkit/typescript init",
  "keywords": [
    "biome",
    "eslint",
    "monorepo",
    "nx",
    "nx-plugin",
    "nx-preset",
    "oxlint",
    "tsdown",
    "tsgo",
    "typecheck",
    "typescript",
    "vitest",
    "zero-config"
  ],
  "homepage": "https://github.com/nx-devkit/nx.ts/tree/main/packages/typescript-preset",
  "bugs": {
    "url": "https://github.com/nx-devkit/nx.ts/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nx-devkit/nx.ts",
    "directory": "packages/typescript-preset"
  },
  "bin": {
    "nx-devkit-typescript": "./dist/bin/init.mjs"
  },
  "files": [
    "dist",
    "generators.json",
    "executors.json",
    "migrations.json",
    "src/generators/init/schema.json",
    "src/generators/monorepo/schema.json",
    "src/generators/package/schema.json",
    "src/executors/typecheck/schema.json",
    "src/executors/build/schema.json",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/plugin.mjs",
  "module": "./dist/plugin.mjs",
  "types": "./dist/plugin.d.mts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.mts",
      "default": "./dist/plugin.mjs"
    },
    "./generators/init": {
      "types": "./dist/generators/init/generator.d.mts",
      "default": "./dist/generators/init/generator.mjs"
    },
    "./generators/monorepo": {
      "types": "./dist/generators/monorepo/generator.d.mts",
      "default": "./dist/generators/monorepo/generator.mjs"
    },
    "./generators/package": {
      "types": "./dist/generators/package/generator.d.mts",
      "default": "./dist/generators/package/generator.mjs"
    },
    "./executors/typecheck": {
      "types": "./dist/executors/typecheck/executor.d.mts",
      "default": "./dist/executors/typecheck/executor.mjs"
    },
    "./executors/build": {
      "types": "./dist/executors/build/executor.d.mts",
      "default": "./dist/executors/build/executor.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "npm run build -- --clean",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nx/devkit": "^24.0.0",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@nx-devkit/internal": "0.0.0",
    "tsdown": "^0.23.7",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@biomejs/biome": "^2.0.0",
    "eslint": "^9.0.0",
    "oxlint": "^1.0.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.0 || ^7.0.0",
    "vitest": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@biomejs/biome": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "tsdown": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "executors": "./executors.json",
  "generators": "./generators.json",
  "nx-migrations": {
    "migrations": "./migrations.json"
  }
}
